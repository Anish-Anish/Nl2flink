# Copy to .env and adjust. Every variable matches a field in backend/config.py.

# ── Postgres: the operational database Debezium captures from ────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=megastore_retail
POSTGRES_USER=megastore
POSTGRES_PASSWORD=megastore
POSTGRES_SCHEMA=public

# ── The studio's own database (pipeline requests, approvals, deployments) ────
STUDIO_DB_URL=postgresql+psycopg2://megastore:megastore@localhost:5432/megastore_studio

# ── Debezium (Kafka Connect REST) ────────────────────────────────────────────
DEBEZIUM_URL=http://localhost:8083
DEBEZIUM_PUBLICATION=megastore_publication

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ── Flink. The SQL Gateway's own default is 8083, which Kafka Connect also
#    claims, so it is moved to 8084 here. ────────────────────────────────────
FLINK_SQL_GATEWAY_URL=http://localhost:8084/v1
FLINK_JOB_MANAGER_URL=http://localhost:8081
FLINK_PARALLELISM=4
FLINK_CHECKPOINT_INTERVAL_MS=60000

# ── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=megastore
SNOWFLAKE_USER=megastore_service
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=MEGASTORE_ENGINEER
SNOWFLAKE_WAREHOUSE=MEGASTORE_WH
SNOWFLAKE_DATABASE=MEGASTORE_DW
SNOWFLAKE_SCHEMA=ANALYTICS

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#ops-alerts

# ── GitHub: where approved pipeline YAML is committed ────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=megastore
GITHUB_REPO=megastore-pipelines
GITHUB_BRANCH=main

# ── The fine-tuned model server (model_server/model_server.py) ───────────────
MODEL_SERVER_URL=http://localhost:9000
MODEL_MAX_NEW_TOKENS=512
MODEL_TIMEOUT_SECONDS=300
MODEL_NAME=Qwen2.5-14B (MegaStore-LoRA)

# ── Agent behaviour ──────────────────────────────────────────────────────────
MAX_CORRECTION_ATTEMPTS=3

# ── UI -> API ────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
